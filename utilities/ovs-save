case $0 in
    */*) dir0=`echo "$0" | sed 's,/[^/]*$,,'` ;;
    *) dir0=./ ;;
esac
. "$dir0/ovs-lib" || exit 1

usage() {
    UTIL=$(basename $0)
    cat <<EOF
${UTIL}: Provides helper functions to save Open vSwitch's configuration.
usage: $0 COMMAND

Commands:
 save-interfaces        Outputs a shell script on stdout that will restore
                        the current kernel configuration of the specified
                        network interfaces, as well as the system iptables
                        configuration.
 save-flows             Outputs a shell script on stdout that will restore
                        OpenFlow flows of each Open vSwitch bridge.
This script is meant as a helper for the Open vSwitch init script commands.
EOF
}

save_interfaces () {
    if (ip link show) > /dev/null 2>&1; then :; else
        echo "$0: ip not found in $PATH" >&2
        exit 1
    fi

    if test "$#" = 0; then
        exit 0
    fi

    devs="$@"
    for dev in $devs; do
        state=`ip link show dev $dev` || continue

        echo "# $dev"
        # Link state (Ethernet addresses, up/down, ...)
        linkcmd=
        case $state in
            *"state UP"* | *[,\<]"UP"[,\>]* )
                linkcmd="$linkcmd up"
                ;;
            *"state DOWN"*)
                linkcmd="$linkcmd down"
                ;;
        esac
        if expr "$state" : '.*\bdynamic\b' > /dev/null; then
            linkcmd="$linkcmd dynamic"
        fi
        if qlen=`expr "$state" : '.*qlen \([0-9]\+\)'`; then
            linkcmd="$linkcmd txqueuelen $qlen"
        fi
        if hwaddr=`expr "$state" : '.*link/ether \([^ ]*\)'`; then
            linkcmd="$linkcmd address $hwaddr"
        fi
        if brd=`expr "$state" : '.*brd \([^ ]*\)'`; then
            linkcmd="$linkcmd broadcast $brd"
        fi
        if mtu=`expr "$state" : '.*mtu \([0-9]\+\)'`; then
            linkcmd="$linkcmd mtu $mtu"
        fi
        if test -n "$linkcmd"; then
            echo ip link set dev $dev down # Required to change hwaddr.
            echo ip link set dev $dev $linkcmd
        fi

        move_ip_address $dev $dev

        move_ip_routes $dev $dev

        echo
    done

    if (iptables-save) > /dev/null 2>&1; then
        echo "# global"
        echo "iptables-restore <<'EOF'"
        iptables-save
        echo "EOF"
    else
        echo "# iptables-save not found in $PATH, not saving iptables state"
    fi
}

get_highest_ofp_version() {
    ovs-vsctl get bridge "$1" protocols | \
        sed 's/[][]//g' | sed 's/\ //g' | \
            awk -F ',' '{ print (NF>0)? $(NF) : "OpenFlow14" }'
}

save_flows () {
    if (ovs-ofctl --version) > /dev/null 2>&1; then :; else
        echo "$0: ovs-ofctl not found in $PATH" >&2
        exit 1
    fi

    # OVS 2.7 and earlier do not enable OpenFlow 1.4 (by default) and lack
    # other features needed to save and restore flows.  Don't try.
    case `ovs-appctl version | sed 1q` in
        "ovs-vswitchd (Open vSwitch) 1."*.*)
            return
            ;;
        "ovs-vswitchd (Open vSwitch) 2."[0-7].*)
            return
            ;;
    esac

    # Without this, a failing command partway through the generated script
    # (a bad add-meter, a rejected replace-flows bundle) is silently masked:
    # the script has no error checking of its own, so it keeps going and the
    # *last* command run - "rm -rf $workdir" below, which essentially always
    # succeeds - becomes the exit status the caller sees, reporting a failed
    # restore as a clean success. set -e makes the first real failure abort
    # the script immediately, so that exit status (and the fact that
    # $workdir is deliberately left behind on failure, unlike this cleanup
    # on the success path, for post-mortem inspection) means what it says.
    echo "set -e"

    workdir=$(mktemp -d "${TMPDIR:-/tmp}/ovs-save.XXXXXXXXXX")
    for bridge in "$@"; do
        # Get the highest enabled OpenFlow version
        ofp_version=$(get_highest_ofp_version "$bridge")

        printf "%s" "ovs-ofctl -O $ofp_version add-tlv-map ${bridge} '"
        ovs-ofctl dump-tlv-map ${bridge} -O $ofp_version | \
        awk '/^  *0x/ {if (cnt != 0) printf ","; \
             cnt++;printf "{class="$1",type="$2",len="$3"}->"$4}'
        echo "'"

        # Meters can't be included in the OpenFlow 1.4 bundle transaction
        # used below for groups/flows (OFPTYPE_METER_MOD isn't bundlable -
        # see lib/ofp-bundle.c's ofputil_is_bundlable()), and a flow
        # referencing a meter that doesn't exist yet fails the *entire*
        # bundle replay with OFPERR_OFPMMFC_INVALID_METER (ofproto.c's
        # ofproto_check_ofpacts()). So meters are restored first, as
        # individual non-bundled add-meter commands - one per dumped meter,
        # since ovs-ofctl has no file-based bulk add-meters command like
        # add-groups/replace-flows. Meters require OpenFlow 1.3+ (see
        # lib/ofp-meter.c), a stricter floor than groups/flows' 1.4 bundle
        # gate just below, so this is gated separately.
        if [ ${ofp_version#OpenFlow} -ge 13 ]; then
            # dump-meters prints one "meter=<id> <flags> bands=" header line
            # per meter, followed by one "type=... rate=..." line per band -
            # the bands are *not* on the header line. Grepping for just the
            # "^meter=" lines (as this used to) threw every band away, always
            # emitting a bandless "add-meter ... bands=" - OVS rejects that
            # outright for having no bands, so the meter was never actually
            # recreated and any flow referencing it then failed too. This
            # instead buffers each meter's header line together with every
            # following "type=" line up to the next "meter=" line (or EOF),
            # joining the header directly to the first band and comma-joining
            # any further bands - the syntax add-meter expects for multiple
            # bands on one meter.
            ovs-ofctl -O $ofp_version dump-meters "$bridge" | \
                awk '
                    /^meter=/ {
                        if (meter != "") print meter
                        meter = $0
                        first = 1
                        next
                    }
                    /^type=/ {
                        if (meter == "") next
                        if (first) { meter = meter $0; first = 0 }
                        else { meter = meter "," $0 }
                        next
                    }
                    END { if (meter != "") print meter }
                ' | \
                while IFS= read -r meter_line; do
                    printf "%s" "ovs-ofctl -O $ofp_version add-meter ${bridge} '"
                    printf '%s' "$meter_line"
                    echo "'"
                done
        fi

        # If possible use OpenFlow 1.4 atomic bundle txn for flows and groups
        [ ${ofp_version#OpenFlow} -ge 14 ] && bundle=" --bundle" || bundle=""

        echo "ovs-ofctl -O $ofp_version add-groups ${bridge} \
              \"$workdir/$bridge.groups.dump\" ${bundle}"

        echo "ovs-ofctl -O $ofp_version replace-flows ${bridge} \
              \"$workdir/$bridge.flows.dump\" ${bundle}"

        ovs-ofctl -O $ofp_version dump-groups "$bridge" | \
            sed -e '/^OFPST_GROUP_DESC/d' \
                -e '/^NXST_GROUP_DESC/d' > \
                "$workdir/$bridge.groups.dump"

        ovs-ofctl -O $ofp_version dump-flows --no-names --no-stats "$bridge" | \
            sed -e '/NXST_FLOW/d' \
                -e '/OFPST_FLOW/d' \
                -e 's/\(idle\|hard\)_age=[^,]*,//g' \
                -e 's/igmp_type/tp_src/g' \
                -e 's/igmp_code/tp_dst/g' \
                -e 's/igmp/ip,nw_proto=2/g' > \
                "$workdir/$bridge.flows.dump"
    done
    echo "rm -rf \"$workdir\""
}

while [ $# -ne 0 ]
do
    case $1 in
        "save-flows")
            shift
            save_flows "$@"
            exit 0
            ;;
        "save-interfaces")
            shift
            save_interfaces "$@"
            exit 0
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo >&2 "$0: unknown command \"$1\" (use --help for help)"
            exit 1
            ;;
    esac
done

exit 0
