[Unit]
Description=Open vSwitch Forwarding Unit
After=ovsdb-server.service network-pre.target systemd-udev-settle.service
Before=network.target networking.service
Requires=ovsdb-server.service
ReloadPropagatedFrom=ovsdb-server.service
AssertPathIsReadWrite=/var/run/openvswitch/db.sock
PartOf=openvswitch-switch.service
DefaultDependencies=no

[Service]
LimitNOFILE=1048576
Type=forking
PIDFile=/run/openvswitch/ovs-vswitchd.pid
Restart=on-failure
Environment=HOME=/var/run/openvswitch
EnvironmentFile=-/etc/default/openvswitch-switch
ExecStart=/usr/share/openvswitch/scripts/ovs-ctl \
          --no-ovsdb-server --no-monitor --system-id=random \
          --no-record-hostname \
          start $OVS_CTL_OPTS
# A plain "stop" (ovs-ctl's stop_daemon) tells ovs-vswitchd to exit without
# first dumping its flow/group/meter/port state, so ofproto's normal
# exit-time cleanup deletes every bridge and port - the kernel datapath goes
# empty and stays that way until something external reprograms it from
# scratch. Using the same save-flows/flow-restore-wait/restore-flows cycle
# ExecReload already uses here means any restart of this unit - whatever
# triggers it (systemctl restart, needrestart, a package upgrade) - saves the
# current flow state, restarts cleanly, and replays it, instead of leaving
# the bridge with zero flows until ovn-controller (or whatever owns it)
# notices and recomputes. ExecStart below still runs afterward as part of a
# normal systemd restart cycle; ovs-ctl's own start already no-ops safely if
# the daemon this just brought up is already running.
ExecStop=/usr/share/openvswitch/scripts/ovs-ctl --no-ovsdb-server \
          --no-monitor --system-id=random \
          --no-record-hostname \
          restart $OVS_CTL_OPTS
ExecReload=/usr/share/openvswitch/scripts/ovs-ctl --no-ovsdb-server \
          --no-monitor --system-id=random \
          --no-record-hostname \
          restart $OVS_CTL_OPTS
TimeoutSec=300
