[Unit]
Description=Open vSwitch Database Unit
After=systemd-journald.socket network-pre.target dpdk.service local-fs.target
Before=network.target networking.service
PartOf=openvswitch-switch.service
DefaultDependencies=no

[Service]
LimitNOFILE=1048576
Type=forking
PIDFile=/run/openvswitch/ovsdb-server.pid
Restart=on-failure
EnvironmentFile=-/etc/default/openvswitch-switch
ExecStart=/usr/share/openvswitch/scripts/ovs-ctl \
          --no-ovs-vswitchd --no-monitor --system-id=random \
          --no-record-hostname \
          start $OVS_CTL_OPTS
# ovsdb-server owns no flows of its own - those live entirely in
# ovs-vswitchd/the kernel datapath, preserved by ovs-vswitchd.service's own
# ExecStop/ExecStart. So this unit's restart just needs to bounce the
# database process without disturbing the Bridge/Port/Interface config
# already on disk (the config is a file, not in-memory state - stop_daemon
# doesn't touch it).
#
# This deliberately does NOT use ovs-ctl's "restart" command: restart()
# unconditionally calls flow_restore_wait/restore_flows regardless of
# --no-ovs-vswitchd, which only gates the earlier save_flows_if_required
# check - so scoped to just ovsdb-server it always tries to restore a flows
# script that was never saved, fails, and systemd sees that failure as the
# ExecStop control process itself failing (Restart=on-failure then loops:
# stop/start/fail, stop/start/fail...).
#
# It also deliberately does NOT do a self-contained stop+start cycle inside
# ExecStop alone (an earlier version of this fix did, on the theory that
# ExecStart would then just see the daemon already running and no-op):
# systemd's default KillMode=control-group sweeps every process left in this
# unit's cgroup once ExecStop's script exits, which kills whatever ExecStop
# had just started back up - so plain stop/start has to be split across
# ExecStop (stop only) and ExecStart (start only, already in place above),
# one full cycle per restart, not two.
ExecStop=/usr/share/openvswitch/scripts/ovs-ctl --no-ovs-vswitchd \
          --no-monitor --no-record-hostname stop
ExecReload=/usr/share/openvswitch/scripts/ovs-ctl --no-ovs-vswitchd \
          --no-monitor --system-id=random --no-record-hostname \
          start $OVS_CTL_OPTS
