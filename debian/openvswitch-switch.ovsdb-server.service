[Unit]
Description=Open vSwitch Database Unit
After=systemd-journald.socket network-pre.target dpdk.service local-fs.target
Before=network.target networking.service
PartOf=openvswitch-switch.service
DefaultDependencies=no

[Service]
LimitNOFILE=1048576
Type=forking
PIDFile=/run/openvswitch/ovsdb-server.pid
Restart=on-failure
EnvironmentFile=-/etc/default/openvswitch-switch
ExecStart=/usr/share/openvswitch/scripts/ovs-ctl \
          --no-ovs-vswitchd --no-monitor --system-id=random \
          --no-record-hostname \
          start $OVS_CTL_OPTS
# ovsdb-server owns no flows of its own - those live entirely in
# ovs-vswitchd/the kernel datapath, preserved by ovs-vswitchd.service's own
# ExecStop. So this unit's restart just needs to bounce the database process
# without disturbing the Bridge/Port/Interface config already on disk, which
# a plain stop+start already does (the config is a file, not in-memory
# state - stop_daemon doesn't touch it).
#
# This deliberately does NOT use ovs-ctl's "restart" command (what
# ExecReload used before this change, and what ovs-vswitchd.service's own
# ExecStop correctly uses): restart() unconditionally calls flow_restore_wait/
# restore_flows regardless of --no-ovs-vswitchd, which only gates the
# earlier save_flows_if_required check - so scoped to just ovsdb-server it
# always tries to restore a flows script that was never saved, fails, and
# systemd sees that failure as the ExecStop control process itself failing
# (Restart=on-failure then loops: stop/start/fail, stop/start/fail...). This
# was already broken on ExecReload before this change, just never exercised
# until ExecStop started using the same command.
ExecStop=/bin/sh -c '/usr/share/openvswitch/scripts/ovs-ctl --no-ovs-vswitchd --no-monitor stop; /usr/share/openvswitch/scripts/ovs-ctl --no-ovs-vswitchd --no-monitor --system-id=random --no-record-hostname start $OVS_CTL_OPTS'
ExecReload=/bin/sh -c '/usr/share/openvswitch/scripts/ovs-ctl --no-ovs-vswitchd --no-monitor stop; /usr/share/openvswitch/scripts/ovs-ctl --no-ovs-vswitchd --no-monitor --system-id=random --no-record-hostname start $OVS_CTL_OPTS'
